# Screen Time Balancer - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for backend operations only - keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
APP_ENVIRONMENT=development  # development, staging, production
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false

# Child App Configuration
CHILD_SYNC_INTERVAL_SECONDS=300  # 5 minutes
CHILD_HEARTBEAT_INTERVAL_SECONDS=30
CHILD_ENABLE_STRICT_MODE=true

# Parent App Configuration
PARENT_SYNC_INTERVAL_SECONDS=60  # 1 minute
PARENT_ENABLE_REALTIME=true

# Feature Flags
FEATURE_OFFLINE_MODE=true
FEATURE_LOCAL_ENFORCEMENT=true
FEATURE_ADVANCED_ANALYTICS=false
